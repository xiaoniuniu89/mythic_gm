rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isInvited(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email));
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isInvited(userId);
    }

    match /allowedEmails/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }
  }
}
